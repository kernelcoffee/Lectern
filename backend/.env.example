# Copy to backend/.env to override defaults.

# Directory holding all persistent state (db, java/, cache/, backups/, servers/).
LECTERN_DATA=./data

# API bind address.
LECTERN_HOST=0.0.0.0
LECTERN_PORT=8000

# Default memory (MB) pre-filled in the create-server wizard.
LECTERN_DEFAULT_MEMORY_MB=2048
