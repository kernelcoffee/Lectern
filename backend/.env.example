# Copy to backend/.env to override defaults.

# Directory holding all persistent state (db, java/, cache/, backups/, servers/).
LECTERN_DATA=./data

# API bind address.
LECTERN_HOST=0.0.0.0
LECTERN_PORT=8000

# Extra names Lectern may be reached by, comma-separated: typically a reverse
# proxy's public domain. IP addresses, localhost, single-word names and names
# under .local, .lan, .home.arpa or .internal need no entry. "*" switches the
# Host and Origin checks off.
# LECTERN_ALLOWED_HOSTS=mc.example.org

# Default memory (MB) pre-filled in the create-server wizard.
LECTERN_DEFAULT_MEMORY_MB=2048
